/-
Cross-check of the Lean game definition against the brute-force solver `lead_a2.py` on every cell
a, b <= 40 of three pairs (S1 -> S2), data generated by `crosscheck_leada.py`.  Proved by
kernel `decide` (not the native evaluator).  Also checks that the mode-1 table agrees with the
Sprague-Grundy criterion (P iff g a = g b) that `lead_a2.py` and the certificate use.
-/
import LeadADefs
import LeadACrossData
namespace LeadA

/-- The Lean mode-0 table (the table `outcome` reads from, built for sizes 0..N) is EQUAL, row by
row and cell by cell, to `data` (the solver's table, rows a, columns b, a, b <= N). -/
def crossOk (S1 S2 : List Nat) (N : Nat) (data : List (List Bool)) : Bool :=
  mode0Table S1 S2 N == data

/-- `outcome` itself (which rebuilds a table of size max a b for every call, so it is slow) agrees
with `data` at every cell with a, b <= N.  Used for a small N only. -/
def outcomeOk (S1 S2 : List Nat) (N : Nat) (data : List (List Bool)) : Bool :=
  (List.range (N + 1)).all fun a => (List.range (N + 1)).all fun b =>
    outcome S1 S2 a b == tget data a b

/-- The table "P iff the two Grundy values are equal" for heaps 0..N. -/
def sgGrid (g : List Nat) (N : Nat) : List (List Bool) :=
  (List.range (N + 1)).map fun a => (List.range (N + 1)).map fun b => g.getD a 0 == g.getD b 0

/-- The mode-1 table is P exactly when the Grundy values of the two heaps are equal, for
a, b <= N. -/
def sgOk (S2 : List Nat) (N : Nat) : Bool :=
  mode1Table S2 N == sgGrid (sgList S2 (N + 1)) N

end LeadA
