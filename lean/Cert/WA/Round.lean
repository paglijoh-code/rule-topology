theorem init_ok : cert.InitOk := by
  intro x
  have e1 : endShape = (cert.cls (cert.k0 % cert.R)).init := by decide +kernel
  have e2 : endCnt = evC (cert.cls (cert.k0 % cert.R)).cn0 (cert.k0 / cert.R) 0 := by decide +kernel
  have e3 : endRows = cert.T0 := by decide
  have h := initial_run x
  rw [e1, e2, e3] at h
  exact h

def certified : Cert := ⟨cert, init_ok⟩

/-- The wall law of wall WA. -/
theorem wall : WallLaw cert := family_wall_law certified round_ok

